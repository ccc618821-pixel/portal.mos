import tkinter as kt 
import psycopg2
DB_HOST = "localhost"
DB_NAME = "ivan"
DB_USER = "postgres"
DB_PASS = "Timon2008.!"
DB_PORT = "5432"
def fetch_users():
    try:
                conn = psycopg2.connect(
            host=DB_HOST,
            database=DB_NAME,
            user=DB_USER,
            password=DB_PASS,
            port=DB_PORT
        )
cur = conn.cursor()
cur.execute("""
            SELECT u.user_id, u.first_name, u.second_name, u.last_name, u.login, r.role_name
            FROM users u
            LEFT JOIN roles r ON u.role_id = r.role_id;
        """)
rows = cur.fetchall()
for item in tree.get_children():
            tree.delete(item)
for row in rows:
            tree.insert('', 'end', values=row)
cur.close()
conn.close()
except Exception as e:
messagebox.showerror("Ошибка БД", str(e))   
window = tk.Tk()
window.title("Пользователи")
window.geometry("800x400")
tk.Label(window, text="Список пользователей", font=("Arial", 14, "bold")).pack(pady=10)
columns = ("user_id", "first_name", "second_name", "last_name", "login", "role")
tree = ttk.Treeview(window, columns=columns, show="headings")
tree.column("user_id", width=60, anchor="center")
tree.column("first_name", width=120)
tree.column("second_name", width=120)
tree.column("last_name", width=120)
tree.column("login", width=130)
tree.column("role", width=130)
tree.pack (fill="broth", expand = True, pandx=10, pady=5)
